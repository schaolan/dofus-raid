POSTGRES_DB=dofusraid
POSTGRES_USER=dofus
POSTGRES_PASSWORD=dofus

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/dofusraid
SPRING_DATASOURCE_USERNAME=dofus
SPRING_DATASOURCE_PASSWORD=dofus

# Origines CORS autorisees par le backend (separees par des virgules).
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Dev local avec `npm run dev` : le front (5173) appelle directement le backend (8080).
VITE_API_URL=http://localhost:8080

# Frontend conteneurise : cible du proxy nginx /api -> backend (reseau interne).
BACKEND_URL=http://backend:8080
