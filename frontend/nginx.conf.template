# Traite par envsubst au demarrage du conteneur nginx :
#   /etc/nginx/templates/default.conf.template -> /etc/nginx/conf.d/default.conf
# Seule ${BACKEND_URL} (variable d'environnement) est substituee ; les variables
# nginx ($uri, $host, ...) sont laissees intactes.
server {
    listen       80;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # SPA : toute route non-fichier retombe sur index.html (routing cote client)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy des appels API vers le backend.
    # Cote navigateur l'appel est en meme origine (/api/...) -> aucun CORS.
    location /api/ {
        proxy_pass              ${BACKEND_URL};
        proxy_http_version      1.1;
        proxy_ssl_server_name   on;

        # Le backend tourne en scale-to-zero (minReplicas: 0) : la premiere requete
        # apres une periode d'inactivite attend son demarrage a froid. On depasse
        # les 60 s par defaut pour ne pas renvoyer un 504 pendant l'activation.
        proxy_connect_timeout   90s;
        proxy_send_timeout      90s;
        proxy_read_timeout      90s;

        proxy_set_header Host              $proxy_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
    }

    # Cache long pour les assets versionnes par Vite
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
